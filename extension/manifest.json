{
  "manifest_version": 3,
  "name": "Daho",
  "version": "1.0.1",
  "description": "Ochiq sahifani tahlil qiladi — YouTube, Telegram, Instagram va boshqalar.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "sidePanel"],
  "host_permissions": ["https://*/*"],
  "action": { "default_title": "Daho bilan tahlil qilish" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://web.telegram.org/*",
        "https://*.instagram.com/*"
      ],
      "js": ["src/collect.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "src/panel.html" },
  "icons": { "128": "icons/icon128.png" }
}
