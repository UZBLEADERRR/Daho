# Daho Cloud (ixtiyoriy).
#
# Bu qiymatlar boʻlmasa ilova toʻliq mahalliy rejimda ishlaydi:
# foydalanuvchi oʻz Gemini kalitini kiritadi, maʼlumot faqat qurilmada qoladi.
#
# Qiymatlarni Supabase loyihasidan olasiz:
#   Project Settings → API → Project URL va anon/publishable key
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Diqqat: service_role kaliti va GEMINI_API_KEY hech qachon bu yerga
# yozilmaydi — ular faqat Supabase edge funksiyalarining sirlari (secrets).
